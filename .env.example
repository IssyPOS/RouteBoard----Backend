# Copy to .env and fill in before running `docker compose up`.
POSTGRES_PASSWORD=replace-with-a-strong-password
# 32+ random characters - e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret

# Optional - outbound email (ticket replies + the activity audit trail).
# Leave these blank and the app just logs outbound email instead of
# sending it - nothing breaks. See README "Outbound email" for
# ready-to-use values for Gmail / Hostinger / SendGrid / etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_START_TLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=POSShopTicketing
# Set to false to keep writing AuditLog rows without emailing anyone.
AUDIT_EMAIL_ENABLED=true
